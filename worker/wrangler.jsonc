{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tailcat-ssh-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-09-16",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/v1/*"] },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "observability": { "enabled": false },
  "ratelimits": [{ "name": "EXEC_LIMIT", "namespace_id": "202609160127", "simple": { "limit": 20, "period": 60 } }]
}
